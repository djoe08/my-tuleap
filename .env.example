# Copier en .env et renseigner les valeurs (ne JAMAIS committer .env).
# Contrainte Tuleap : au moins 20 caractères, lettres et chiffres uniquement.
# Génération : tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24; echo

TULEAP_FQDN=tuleap.jo.priv
TULEAP_SSH_PORT=2220
TULEAP_DATA_DIR=/volume2/docker/tuleap/data
TULEAP_DB_DIR=/volume2/docker/tuleap/db

MYSQL_ROOT_PASSWORD=change_me_20_chars_minimum_alnum
TULEAP_SYS_DBPASSWD=change_me_20_chars_minimum_alnum
SITE_ADMINISTRATOR_PASSWORD=change_me_20_chars_minimum_alnum

# Optionnel : relais SMTP
TULEAP_EMAIL_RELAYHOST=
TULEAP_SYS_EMAIL_ADMIN=jonathan@jo.priv
